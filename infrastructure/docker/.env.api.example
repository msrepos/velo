# Development only. Copy to .env.api; keep actual values local.
# For Windows-hosted SQL Server, use host.docker.internal instead of localhost.
VELO_SQL_CONNECTION_STRING=Server=host.docker.internal;Database=velo;User Id=sa;Password=REPLACE_LOCALLY;Encrypt=True;TrustServerCertificate=True;Persist Security Info=False
VELO_OTP_HASH_KEY=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
VELO_HTTP_PORT=5080
